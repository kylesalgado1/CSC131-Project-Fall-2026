# Copy to backend/.env (gitignored) and fill in. Never commit real values.

# Supabase: dashboard > Connect > Session pooler. Works over IPv4 and supports
# the transactions the importer uses.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Optional: path to Supabase's CA certificate for verified TLS (Database
# settings > SSL configuration). If you use this, remove any ?sslmode=... from
# DATABASE_URL.
# DATABASE_SSL_CA=/path/to/prod-ca-2021.crt

# TomTom: developer.tomtom.com > your key. Used for routing and traffic.
TOMTOM_API_KEY=

# Place search also uses Photon (OpenStreetMap), which needs no key.
# PLACE_SEARCH_PHOTON=off   # keep search on TomTom only
# PHOTON_URL=               # a Photon server you host, instead of the public one

# --- Devices and monitored trips (iOS client) ---
# The tables come from migration 005: run `npm run migrate` once. Until then
# the device and trip routes answer 503 monitoring_unavailable and everything
# else works as before. (When the database cannot be reached they answer 503
# temporarily_unavailable instead: that is not a missing migration.)

# How many proxies in front of the server to believe about who the client is
# (1 on Render). Without it every client looks like the proxy, so the limit on
# new devices per address (20 an hour) counts them all as one. Leave it unset
# when clients connect to the server directly: a client could then fake its
# address.
# TRUST_PROXY=1

# Secret for POST /internal/monitor/tick, sent as "Authorization: Bearer ...".
# At least 32 characters with no spaces, e.g. `openssl rand -hex 32`. Unset,
# the route answers 404.
# MONITOR_TICK_SECRET=

# Monitoring thresholds. The defaults are shown; a value that is not a whole
# number in range is ignored with a warning.
# MONITOR_LEAD_MINUTES=120         # start monitoring this long before the departure (a multiple of 15, at most 165)
# HEADS_UP_LEAD_MINUTES=90         # send the heads-up this long before the departure (a multiple of 15, at most 165, no more than the lead)
# MEANINGFUL_SHIFT_MINUTES=5       # announce a departure that moved by at least this much (1 to 60)
# UPDATE_MIN_INTERVAL_MINUTES=10   # least time between two updates for one trip (0 to 240)
# MAX_UPDATES_PER_TRIP=3           # most updates one trip gets (0 to 20)
# MONITOR_MAX_LAG_SECONDS=120      # a check later than this counts as late (30 to 600)
# TRIP_RETENTION_HOURS=24          # keep a trip's row this long after it is over (24 to 720)

# --- The monitoring worker: plans trips, checks them and sends alerts while the app is closed ---
# Opt-in. Only a server started with MONITOR=on runs it, and exactly one
# deployment should (render.yaml declares it for the shared one and ships it
# "off": see the README for turning it on). Everywhere else leave it unset:
# the trip routes still take and store trips, but this server plans nothing,
# checks nothing and sends nothing, and the app is told so.
#
# That is about this server, not about the database. Trips, waiting alerts
# and the daily budget live in the database, so if this server shares its
# DATABASE_URL with the deployment that has MONITOR=on, that worker monitors
# the trips stored here and sends real alerts for them, while this server
# still reports that monitoring is off. For development use a private
# database or `npm run serve:fixture`. For the same reason, if ticks are
# driven by `npm run monitor:tick`, the web service needs MONITOR=on too.
# MONITOR=on

# How often the worker ticks inside the server process, in seconds (10 to 900).
# MONITOR_TICK_SECONDS=60

# Set to true only on a host that never puts the server to sleep: it tells the
# app the monitor can be counted on with no outside scheduler. On a host that
# sleeps when idle (Render's free plan) leave it unset, and have a scheduler
# call POST /internal/monitor/tick every minute with MONITOR_TICK_SECRET
# (above) instead; the app is told monitoring is dependable while those calls
# keep coming.
# MONITOR_ALWAYS_ON=true

# The most trip evaluations in one UTC day, shared by every worker on the
# database (0 to 100000; 0 asks the traffic provider nothing). Once it is used
# up no provider is asked until midnight UTC; "time to leave" still goes out
# from the stored plans, marked as not re-checked.
#
# Why 150. TomTom's free plan currently allows about 20,000 routing requests
# and 2,500 traffic-incident requests a MONTH per key (it changes: check
# developer.tomtom.com/pricing). One monitored trip takes about 10 to 12
# evaluations and costs roughly 45 to 55 routing requests and 12 to 24
# incident requests. These are estimates from how the cache and the
# 15-minute checks work, not measurements. A trip whose route cannot be
# planned at all is asked about less and less often (after 1, 2, 5 and 15
# minutes, then every 30), which comes to about 27 evaluations from the
# moment it can first be planned to its arrival time.
#   routing:   20,000 / 50 = about 400 trips a month, or 13 a day = about 150
#              evaluations a day. That is the default.
#   incidents:  2,500 / 18 = about 140 trips a month, or 4 to 5 a day. Past
#              that TomTom refuses incident requests until the month renews;
#              the live delay is still counted, but incident reports are
#              missing. To stay inside this allowance too, use about 50.
# The React Native app's verdict screen and place search draw on the same key.
# MONITOR_DAILY_EVALUATION_BUDGET=150

# --- Apple push notifications (APNs), for the alerts ---
# Without these the worker still plans and monitors trips, and the app is told
# that alerts cannot be sent. All of them come from the Apple Developer
# account (Certificates, Identifiers & Profiles > Keys) and need a paid
# membership. The key is a secret: never commit it (*.p8 is gitignored).
# APNS_KEY_ID=                 # the key's 10-character id
# APNS_TEAM_ID=                # the team's 10-character id
# APNS_BUNDLE_ID=com.waititout.uxprototype   # the app's bundle id (this is the default)
# The .p8 key, one of:
# APNS_PRIVATE_KEY=            # its PEM text on one line, with \n for each line break
# APNS_PRIVATE_KEY_FILE=       # or the path to the .p8 file
