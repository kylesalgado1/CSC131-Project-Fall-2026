# Copy to backend/.env (gitignored) and fill in. Never commit real values.

# Supabase: dashboard > Connect > Session pooler. Works over IPv4 and supports
# the transactions the importer uses.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Optional: path to Supabase's CA certificate for verified TLS (Database
# settings > SSL configuration). If you use this, remove any ?sslmode=... from
# DATABASE_URL.
# DATABASE_SSL_CA=/path/to/prod-ca-2021.crt
